# Postgres connection string (Neon: use the pooled "-pooler" URL from the dashboard)
NEON_POSTGRES=
# 32+ char random string: encrypts stored NWC strings
APP_SECRET=change-me-to-a-long-random-string
# Grader (Google Gemini, key from aistudio.google.com/apikey). Leave empty to use a basic offline heuristic grader.
GEMINI_API_KEY=
GRADER_MODEL=gemini-3.5-flash
AUDIO_GRADER_MODEL=gemini-2.5-flash
# Nostr relays (comma separated) for publishing tasks
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# Set to 1 to simulate payouts without moving sats (demo/testing)
MOCK_PAYMENTS=0
# Per-worker daily payout cap in sats
DAILY_CAP_SATS=2000
# Sandbox wallet that funds the demo tasks (create with: npm run demo:wallet)
DEMO_NWC=
SEED_DEMO=0
GRADER_FALLBACK_MODEL=gemini-2.5-flash
# Sandbox only: allow worker wallet links that can also SEND payments (a faucet wallet link can). Leave off in production.
ALLOW_SPENDING_WALLET_LINKS=0
# Languages switched on for training (build-time). Comma-separated registry names, or * for all plus any typed name.
NEXT_PUBLIC_LANGUAGES=English,Nigerian Pidgin,Yoruba,Hausa
